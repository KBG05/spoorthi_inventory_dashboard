# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string for the spoorthi_inventory_db database.
DATABASE_URL=postgresql+psycopg2://inventory_app:CHANGE_ME@localhost:5432/spoorthi_inventory_db

# Secret used to sign JWT access tokens. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Comma-separated list is not supported directly; edit app/config.py's default if you need
# more than the local Vite dev origins below, or set as a JSON array:
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Absolute paths to the source Excel files ingested by POST /ingestion/recompute
# when no explicit path is provided in the request body.
CONSUMPTION_FILE=/absolute/path/to/Raw Material Consumption data from April 2025 to August 2026.xlsx
PROCUREMENT_FILE=/absolute/path/to/Format - Raw Material Received Details for IO.xlsx
